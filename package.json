{
  "name": "iso-safety-signs-monorepo",
  "private": true,
  "description": "ISO 7010 safety sign pictograms for React, Vue 3, Web Components, CSS sprite and SVG sprite",
  "workspaces": [
    "packages/@iso-safety-signs/*",
    "apps/*"
  ],
  "scripts": {
    "audit-actions": "node scripts/audit-action-inputs.mjs",
    "build": "yarn update && yarn compile",
    "build-docs": "yarn workspace @iso-docs/app build",
    "build-storybook": "yarn workspace @iso-storybook/app build-storybook",
    "changeset": "changeset",
    "check": "manypkg check",
    "compile": "yarn workspaces foreach -A --topological-dev run compile",
    "docs": "yarn workspace @iso-docs/app dev",
    "format": "oxfmt --write --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path=.oxfmtignore .",
    "generate": "tsx bin/generate-source.ts",
    "lint": "oxlint .",
    "prepare": "lefthook install",
    "publish": "yarn changeset publish",
    "storybook": "yarn workspace @iso-storybook/app storybook",
    "test": "yarn workspaces foreach -A run test",
    "type-check": "yarn workspaces foreach -A --include '@iso-safety-signs/*' run type-check",
    "update": "tsx bin/update.ts",
    "version-packages": "changeset version && yarn install --mode=update-lockfile && yarn format"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@manypkg/cli": "^0.25.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "glob": "^14.0.4",
    "lefthook": "^2.1.14",
    "marked": "^18.0.13",
    "node-html-parser": "^9.0.4",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sharp": "^0.35.4",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "svgo": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "yaml": "^2.9.1"
  },
  "resolutions": {
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "js-yaml": "^4.1.1",
    "minimatch": "^9.0.7",
    "node-gyp": "^12.0.0",
    "picomatch": "^4.0.4",
    "tar": "^7.5.13"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
